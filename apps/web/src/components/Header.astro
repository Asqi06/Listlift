---
import ThemeToggle from './ThemeToggle.tsx';

const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/studio', label: 'Studio' },
  { href: '/autofill', label: 'Auto-Fill Agent' },
  { href: '/tools/', label: 'Free Tools' },
  { href: '/marketplaces/etsy', label: 'Marketplaces' },
  { href: '/guides/', label: 'Guides' },
  { href: '/pricing', label: 'Pricing' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="ListLift home">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <rect width="24" height="24" rx="6" fill="currentColor" />
        <path d="M7 7v10h4.5M13 7v10h4.5" stroke="var(--surface)" stroke-width="2" stroke-linecap="square" />
      </svg>
      <span class="brand-name">ListLift</span>
    </a>

    <nav class="main-nav" aria-label="Primary navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { 'is-current': pathname.startsWith(link.href) }]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="btn btn-ghost btn-sm cmd-trigger"
        data-open-cmd
        aria-label="Open quick search (Ctrl+K)"
      >
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <kbd class="kbd">⌘K</kbd>
      </button>
      <ThemeToggle client:load />
      <a href="/studio" class="btn btn-primary btn-sm header-cta">Start Free</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }
  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.08rem;
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .brand:hover {
    text-decoration: none;
  }
  .main-nav {
    display: none;
    align-items: center;
    gap: 4px;
  }
  @media (min-width: 860px) {
    .main-nav {
      display: flex;
    }
  }
  .nav-link {
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 150ms ease, background-color 150ms ease;
  }
  .nav-link:hover,
  .nav-link.is-current {
    color: var(--text);
    background: var(--subtle);
    text-decoration: none;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .kbd {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 5px;
    border-radius: 5px;
    border: 1px solid var(--border);
    background: var(--subtle);
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .header-cta {
      display: none;
    }
  }
</style>
