---
import { ClientRouter } from 'astro:transitions';
import '@listlift/ui/tokens.css';
import '@listlift/ui/base.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.tsx';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://listlift.com').toString();
const fullTitle = title.includes('ListLift') ? title : `${title} | ListLift`;
const pathname = Astro.url.pathname;
const globalOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ListLift',
  url: 'https://listlift.com',
  description:
    'Global photo-to-listing platform and universal 1-click Chrome/Edge Auto-Fill Extension for Amazon, Etsy, eBay, Shopify, Walmart, Flipkart, Meesho, and Shopee sellers.',
};
const combinedJsonLd = jsonLd
  ? [globalOrgSchema, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [globalOrgSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-US" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-GB" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-CA" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-AU" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-IN" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-SG" href={canonicalUrl} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content="ListLift" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&family=Newsreader:ital,opsz,wght@1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyTheme() {
          try {
            var match = document.cookie.match(/(?:^|;\s*)ll_theme=(light|dark)/);
            if (match) {
              document.documentElement.setAttribute('data-theme', match[1]);
            }
          } catch (_) {}
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(combinedJsonLd)}
    />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="sr-only" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <nav class="mobile-tabbar" aria-label="Mobile navigation">
      <a href="/studio" class:list={['tab-item', { 'is-active': pathname.startsWith('/studio') }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9 3v18"/></svg>
        <span>Studio</span>
      </a>
      <a href="/tools/" class:list={['tab-item', { 'is-active': pathname.startsWith('/tools') }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <span>Tools</span>
      </a>
      <a href="/guides/" class:list={['tab-item', { 'is-active': pathname.startsWith('/guides') }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
        <span>Guides</span>
      </a>
      <a href="/pricing" class:list={['tab-item', { 'is-active': pathname.startsWith('/pricing') }]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>Pricing</span>
      </a>
    </nav>

    <CommandPalette client:idle />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>

<style>
  .mobile-tabbar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
    z-index: 45;
    background: var(--surface);
    border-top: 1px solid var(--border);
  }
  @media (min-width: 768px) {
    .mobile-tabbar {
      display: none;
    }
  }
  .tab-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
  }
  .tab-item.is-active {
    color: var(--primary);
  }
</style>
