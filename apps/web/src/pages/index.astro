---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroWorkbench from '../components/funnel/HeroWorkbench.tsx';
import RoiCalculator from '../components/funnel/RoiCalculator.tsx';
import PricingSection from '../components/funnel/PricingSection.tsx';
import { getAllMarketplaceSkills } from '@listlift/skills';

const skills = getAllMarketplaceSkills();

const standaloneTools = [
  {
    href: '/tools/title-generator',
    name: 'Title Generator + Limit Checker',
    desc: 'Generate 5 rule-checked title angles with live character meters and keyword coverage.',
    meta: '5 variants / run',
  },
  {
    href: '/tools/description-generator',
    name: 'Description + Bullets Generator',
    desc: 'Turn product specs into short hooks, scannable bullets, and full descriptions in 3 tones.',
    meta: 'Claim-safe',
  },
  {
    href: '/tools/tags-generator',
    name: 'Tags & Keywords Generator',
    desc: 'Fill all 13 Etsy tag slots (≤20 chars) and deduplicated 250-byte Amazon search terms.',
    meta: '13 slots + UTF-8',
  },
  {
    href: '/tools/sku-generator',
    name: 'SKU Generator (Batch + CSV)',
    desc: 'Build clean, uppercase SKUs across variants with automatic duplicate detection.',
    meta: 'Duplicate check',
  },
  {
    href: '/tools/listing-score',
    name: 'Listing Score (0–100 Linter)',
    desc: 'Audit existing copy for over-limit fields, repeated words, and risky promotional claims.',
    meta: '0–100 score',
  },
  {
    href: '/tools/competitor-compare',
    name: 'Competitor Compare Matrix',
    desc: 'Compare 2–10 listings side by side for price band (min/median/max) and keyword gaps.',
    meta: 'Price band',
  },
  {
    href: '/tools/character-counter',
    name: 'Character & UTF-8 Byte Counter',
    desc: 'Verify exact character and UTF-8 byte caps across all 8 launch marketplaces.',
    meta: '8 marketplaces',
  },
];

const faqs = [
  {
    q: 'Do I need an account to test ListLift?',
    a: 'No. Listing Studio and all 7 standalone tools work immediately without signup. Create an account or upgrade only when you want higher daily limits, Bulk CSV, or saved brand voices.',
  },
  {
    q: 'Does ListLift guarantee #1 ranking on Amazon or Etsy?',
    a: 'No tool can guarantee marketplace rank because rank also depends on sales velocity, reviews, pricing, and conversion. ListLift saves hours of manual writing, fills unused search slots, and catches rule violations before upload.',
  },
  {
    q: 'How does ListLift stop AI from inventing fake specs?',
    a: 'Your hard facts (material, dimensions, pack count) stay locked. Every factual claim is audited against your input or cited competitor evidence, and anything unverified is flagged amber before you copy.',
  },
  {
    q: 'Which countries and marketplaces does ListLift support?',
    a: 'ListLift is built for global sellers across the US, UK, Europe, Canada, Australia, India, and Southeast Asia — with dedicated field rules for Amazon, Etsy, eBay, Shopify, Walmart, Flipkart, Meesho, and Shopee/Lazada, plus a Universal Auto-Fill Chrome/Edge Extension that works on any custom online store.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'ListLift — Photo-to-Listing Studio & Universal Auto-Fill Extension',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Chrome, Edge',
    url: 'https://listlift.com',
    description:
      'Turn 1 product photo into keyword-rich, claim-safe ecommerce listings across 8 global marketplaces and auto-fill any seller portal or custom store in 1 click using the ListLift Chrome/Edge Extension.',
    featureList: [
      'Photo-first visual inspection that ignores meaningless filenames and flags photo-vs-text mismatches',
      'Universal 1-click Auto-Fill Chrome/Edge Extension for Amazon, Etsy, eBay, Shopify, Walmart, Flipkart, Meesho, Shopee, and custom D2C admin panels',
      'Marketplace-specific seller portal fields with live character and UTF-8 byte enforcement',
      'Similar products benchmark and claim-safety audit',
    ],
    offers: [
      { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Pro', price: '7.50', priceCurrency: 'USD' },
      { '@type': 'Offer', name: 'Business', price: '24.00', priceCurrency: 'USD' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
];
---

<BaseLayout
  title="ListLift: Photo-to-Listing Studio & 1-Click Seller Auto-Fill Extension"
  description="Turn 1 product photo into keyword-rich, rule-checked listings for Amazon, Etsy, eBay, Shopify, Walmart, Flipkart, Meesho, and Shopee, then auto-fill any seller portal in 1 click."
  jsonLd={jsonLd}
>
  <!-- Editorial Split Hero -->
  <section class="hero-band">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 data-hero-stagger>
          From 1 product photo to <span class="serif-accent">published in 2 minutes.</span>
        </h1>
        <p class="hero-lead" data-hero-stagger>
          Upload a product photo and get search-ready titles, bullets, tags, and exact portal fields for 8 global marketplaces. Then click once in the ListLift Chrome Extension to fill your seller portal or custom store without manual copy-pasting.
        </p>
        <div class="hero-actions" data-hero-stagger>
          <a href="/studio" class="btn btn-primary">Open Listing Studio (Free)</a>
          <a href="/autofill" class="btn btn-secondary">Install 1-Click Auto-Fill Extension</a>
        </div>
        <dl class="hero-facts" data-hero-stagger>
          <div>
            <dt>Global marketplaces</dt>
            <dd class="mono">8 built-in</dd>
          </div>
          <div>
            <dt>Free daily runs</dt>
            <dd class="mono">3 Studio / day</dd>
          </div>
          <div>
            <dt>Pro plan</dt>
            <dd class="mono">$7.50 / mo</dd>
          </div>
        </dl>
      </div>

      <div class="hero-stage" data-hero-stagger>
        <HeroWorkbench client:load />
      </div>
    </div>
  </section>

  <!-- Why ListLift Exists + Real Seller Payoff (Zero Clutter, Zero Fake Comparison Tables) -->
  <section class="band band-ruled" data-reveal>
    <div class="container">
      <div class="band-head">
        <h2>Why we built ListLift, and what it saves you every month</h2>
        <p class="muted">
          Listing one product across multiple marketplaces normally takes 25 minutes of rewriting titles, checking byte limits, and pasting fields one by one. ListLift cuts that workflow to 2 minutes from a single photo.
        </p>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:18px;">
        <div class="card" style="display:flex;flex-direction:column;gap:8px;">
          <h3 style="margin:0;font-size:1.05rem;">What you get that copy-only tools skip</h3>
          <ul style="margin:4px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:8px;font-size:0.9rem;color:var(--text-muted);">
            <li><strong>1-Click Auto-Fill Extension:</strong> fills Title, SKU, Bullets, Description, Tags, Search Terms, and SEO Meta inside any marketplace portal or custom store admin.</li>
            <li><strong>Photo-first grounding:</strong> inspects your actual product image, ignores random filenames, and flags conflicts before you publish.</li>
            <li><strong>Exact portal fields:</strong> outputs the specific fields each marketplace requires (Amazon 250-byte terms, Etsy 13 tags, eBay 80-char titles, Flipkart catalog fields, Shopify handles).</li>
          </ul>
        </div>

        <div class="card" style="display:flex;flex-direction:column;gap:8px;">
          <h3 style="margin:0;font-size:1.05rem;">How sellers get the most out of it</h3>
          <ol style="margin:4px 0 0;padding-left:18px;display:flex;flex-direction:column;gap:8px;font-size:0.9rem;color:var(--text-muted);">
            <li>Drop 1 product photo in Listing Studio and pick your target marketplaces.</li>
            <li>Review the Similar Products Benchmark and Claim-Safety flags so nothing triggers suppression.</li>
            <li>Click <strong>Send to Auto-Fill Agent</strong> and fill your live seller dashboard in 1 click.</li>
          </ol>
        </div>

        <div class="card-elevated" style="display:flex;flex-direction:column;gap:8px;border-color:var(--accent);">
          <h3 style="margin:0;font-size:1.05rem;">Is Pro ($7.50/mo) worth paying for?</h3>
          <p style="margin:4px 0 0;font-size:0.9rem;color:var(--text-muted);">
            At 20 new products a month, manual writing and portal pasting takes roughly <strong>8 hours</strong>. With Listing Studio and Auto-Fill, reviewing those same 20 listings takes about <strong>40 minutes</strong>.
          </p>
          <p style="margin:4px 0 0;font-size:0.9rem;">
            That works out to <strong>$0.38 per product</strong> (about $1 per hour saved). One extra order covers the whole month.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Seller ROI & AOV Calculator -->
  <section id="roi" class="band band-ruled" data-reveal>
    <div class="container">
      <div class="band-head">
        <h2>See what your catalog saves every month</h2>
        <p class="muted">
          Move the sliders to match your store or agency volume. ListLift pays for itself on your very first batch.
        </p>
      </div>
      <RoiCalculator client:visible />
    </div>
  </section>

  <!-- Ruled Tool Directory (Flagship + Architectural 2-Column List — zero copy-paste cards) -->
  <section class="band band-ruled" data-reveal>
    <div class="container">
      <div class="band-head-row">
        <div>
          <h2>One rules engine, eight public tools</h2>
          <p class="muted">Start with any single utility free without signup, or run the full workflow in Listing Studio.</p>
        </div>
        <a href="/tools/" class="btn btn-secondary btn-sm">View tools hub</a>
      </div>

      <a href="/studio" class="flagship-row">
        <div>
          <h3>Listing Studio</h3>
          <p class="muted">
            Upload a photo (resized locally to ≤1024px WebP), lock hard facts, and generate complete listings across all 8 marketplaces with an 8-step timeline, score gauge, evidence panel, CSV/JSON export, and read-only client share links.
          </p>
        </div>
        <span class="btn btn-primary">Launch Studio</span>
      </a>

      <ul class="tool-ledger">
        {
          standaloneTools.map((tool) => (
            <li>
              <a href={tool.href} class="tool-row">
                <div class="tool-row-main">
                  <strong>{tool.name}</strong>
                  <span class="muted">{tool.desc}</span>
                </div>
                <div class="tool-row-end">
                  <span class="badge badge-neutral">{tool.meta}</span>
                  <svg class="row-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M5 12h14m-6-6 6 6-6 6" />
                  </svg>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Supported Marketplace Rules Strip -->
  <section class="band band-ruled" data-reveal>
    <div class="container">
      <div class="band-head-row">
        <div>
          <h2>Versioned rules for 8 global marketplaces</h2>
          <p class="muted">Every character limit, UTF-8 byte cap, and banned phrase lives in a human-verified rule file.</p>
        </div>
        <a href="/guides/" class="btn btn-ghost btn-sm">Read seller guides</a>
      </div>

      <div class="chip-group">
        {
          skills.map((s) => (
            <a href={`/marketplaces/${s.marketplace}`} class="chip" style="text-decoration:none;">
              <span>{s.display_name}</span>
              <span class="mono muted" style="font-size:0.75rem;">≤{s.fields.title.max}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- High-AOV Pricing Section directly on Home -->
  <section id="pricing" class="band band-ruled" data-reveal>
    <div class="container">
      <div class="band-head">
        <h2>Pricing built for real seller margins</h2>
        <p class="muted">
          Try Listing Studio and all 7 tools free without an account. Switch to annual billing for two months free — available worldwide.
        </p>
      </div>
      <PricingSection client:visible />
    </div>
  </section>

  <!-- Focused FAQ -->
  <section class="band band-ruled" data-reveal>
    <div class="container faq-container">
      <h2>Common questions</h2>
      <div class="faq-ledger">
        {
          faqs.map((item) => (
            <details class="faq-row">
              <summary>
                <span>{item.q}</span>
                <svg class="faq-chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <p class="muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-band {
    padding: var(--space-12) 0 var(--space-16);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr 1.12fr;
      gap: var(--space-12);
    }
  }
  .hero-copy h1 {
    font-size: clamp(2.4rem, 4.8vw, 3.6rem);
    line-height: 1.06;
    margin-bottom: var(--space-5);
  }
  .hero-copy h1 .serif-accent {
    font-size: 1.08em;
    color: var(--primary-text);
  }
  .hero-lead {
    font-size: 1.0625rem;
    color: var(--muted);
    max-width: 54ch;
    margin: 0 0 var(--space-6);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: var(--space-8);
  }
  .hero-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-top: var(--space-5);
    border-top: 1px solid var(--border);
  }
  .hero-facts dt {
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 2px;
  }
  .hero-facts dd {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .band {
    padding: var(--space-16) 0;
  }
  .band-ruled {
    border-top: 1px solid var(--border);
  }
  .band-head {
    max-width: 64ch;
    margin-bottom: var(--space-8);
  }
  .band-head h2,
  .band-head-row h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: var(--space-2);
  }
  .band-head p,
  .band-head-row p {
    margin: 0;
  }
  .band-head-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .compare-table .row-highlight td {
    background: var(--primary-soft);
  }

  .flagship-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
    margin-bottom: var(--space-6);
    transition: border-color 180ms var(--ease-out), box-shadow 220ms var(--ease-out);
  }
  .flagship-row:hover {
    text-decoration: none;
    border-color: var(--primary);
    box-shadow: var(--shadow-md);
  }
  .flagship-row h3 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .flagship-row p {
    margin: 0;
    max-width: 68ch;
    font-size: 0.94rem;
  }

  .tool-ledger {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 820px) {
    .tool-ledger {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-8);
    }
  }
  .tool-ledger li {
    border-bottom: 1px solid var(--border);
  }
  .tool-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) 6px;
    color: var(--text);
    text-decoration: none;
    transition: background-color 150ms ease;
  }
  .tool-row:hover {
    text-decoration: none;
    background: var(--subtle);
  }
  .tool-row-main {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .tool-row-main strong {
    font-size: 0.98rem;
  }
  .tool-row-main span {
    font-size: 0.86rem;
    line-height: 1.45;
  }
  .tool-row-end {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .row-arrow {
    color: var(--muted);
    transition: transform 180ms var(--ease-out), color 150ms ease;
  }
  .tool-row:hover .row-arrow {
    transform: translateX(3px);
    color: var(--text);
  }

  .faq-container {
    max-width: 820px;
  }
  .faq-container h2 {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    margin-bottom: var(--space-6);
  }
  .faq-ledger {
    border-top: 1px solid var(--border);
  }
  .faq-row {
    border-bottom: 1px solid var(--border);
    padding: var(--space-5) 0;
  }
  .faq-row summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    cursor: pointer;
    font-weight: 600;
    font-size: 1rem;
    list-style: none;
  }
  .faq-row summary::-webkit-details-marker {
    display: none;
  }
  .faq-chevron {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 200ms var(--ease-out);
  }
  .faq-row[open] .faq-chevron {
    transform: rotate(180deg);
  }
  .faq-row p {
    margin: var(--space-3) 0 0;
    max-width: 68ch;
  }
</style>
