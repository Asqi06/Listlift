---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Terms of Service"
  description="ListLift Terms of Service: AI draft verification responsibility, non-affiliation disclaimer, and acceptable use."
>
  <div class="container" style="padding-top: var(--space-8); max-width: 780px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Terms of Service</span>
    </nav>
    <h1>Terms of Service</h1>
    <div class="card" style="display:flex; flex-direction:column; gap:14px;">
      <p><strong>Effective date:</strong> 22 November 2026</p>
      <h2>1. Draft Output &amp; Seller Responsibility</h2>
      <p class="muted">All generated titles, bullets, descriptions, tags, and SKUs are drafts. You are responsible for verifying factual accuracy, trademark rights, and current marketplace policies before publishing.</p>
      <h2>2. No Ranking Guarantees</h2>
      <p class="muted">ListLift helps you save time and follow marketplace formatting rules. We do not guarantee search rankings, impressions, or sales outcomes.</p>
      <h2>3. Non-Affiliation</h2>
      <p class="muted">ListLift is an independent platform and is not affiliated with Amazon, Etsy, eBay, Shopify, Walmart, Flipkart, Meesho, or Shopee/Lazada.</p>
    </div>
  </div>
</BaseLayout>
