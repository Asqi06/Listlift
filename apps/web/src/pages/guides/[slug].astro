---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SELLER_GUIDES, type SellerGuide } from '../../data/guides';

export function getStaticPaths() {
  return SELLER_GUIDES.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

interface Props {
  guide: SellerGuide;
}

const { guide } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.title,
  description: guide.description,
  dateModified: guide.updatedAt,
  author: { '@type': 'Organization', name: 'ListLift' },
};
---

<BaseLayout title={guide.title} description={guide.description} jsonLd={jsonLd}>
  <article class="container" style="padding-top: var(--space-8); max-width: 780px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><a href="/guides/">Guides</a><span>/</span><span aria-current="page">{guide.category}</span>
    </nav>

    <div style="display:flex; gap:10px; align-items:center; margin-bottom: var(--space-3);">
      <span class="badge badge-neutral">{guide.category}</span>
      <span class="muted mono" style="font-size:0.8rem;">{guide.readTime} · Updated {guide.updatedAt}</span>
    </div>

    <h1>{guide.title}</h1>
    <p class="muted" style="font-size:1.08rem; margin-bottom: var(--space-8);">{guide.description}</p>

    <div style="display:flex; flex-direction:column; gap: var(--space-6);">
      {
        guide.sections.map((s) => (
          <section class="card">
            <h2 style="font-size:1.25rem; margin-bottom: var(--space-2);">{s.heading}</h2>
            <p class="muted" style="margin:0;">{s.body}</p>
          </section>
        ))
      }
    </div>

    <div class="card-elevated" style="margin-top: var(--space-8); display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap: 16px;">
      <div>
        <strong>Put this guide into practice right now</strong>
        <p class="muted" style="margin: 4px 0 0; font-size:0.9rem;">Free, no signup required.</p>
      </div>
      <a href={guide.relatedToolHref} class="btn btn-primary">{guide.relatedToolLabel} →</a>
    </div>
  </article>
</BaseLayout>
