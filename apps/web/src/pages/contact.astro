---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Beta Waitlist"
  description="Contact ListLift for beta access, marketplace rule updates, privacy requests, or agency inquiries."
>
  <div class="container" style="padding-top: var(--space-8); max-width: 680px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Contact</span>
    </nav>
    <h1>Contact &amp; Pro Beta Waitlist</h1>
    <p class="muted" style="margin-bottom: var(--space-6);">
      Request early access to Pro/Business plans, report a marketplace rule change, or submit a privacy/data-deletion request.
    </p>
    <div class="card-elevated">
      <form onsubmit="event.preventDefault(); this.querySelector('[data-msg]').textContent = 'Thanks! Your request has been recorded for the beta team.';" style="display:flex; flex-direction:column; gap:14px;">
        <div class="field">
          <label for="c-email">Email address</label>
          <input id="c-email" type="email" required class="input" placeholder="you@store.com" />
        </div>
        <div class="field">
          <label for="c-topic">Topic</label>
          <select id="c-topic" class="select">
            <option>Pro / Business Beta Waitlist</option>
            <option>Report Marketplace Rule Update</option>
            <option>Privacy / Delete My Data</option>
            <option>General Feedback</option>
          </select>
        </div>
        <div class="field">
          <label for="c-notes">Message</label>
          <textarea id="c-notes" required class="textarea" rows={4} placeholder="Which marketplaces do you sell on?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p data-msg class="badge badge-pass" style="margin:0; width:fit-content;" aria-live="polite"></p>
      </form>
    </div>
  </div>
</BaseLayout>
