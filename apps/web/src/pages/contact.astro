---
import BaseLayout from '../layouts/BaseLayout.astro';

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Support, Billing & Privacy Requests | ListLift',
  url: 'https://listlift.com/contact',
  description:
    'Contact ListLift for subscription billing, refund requests, GDPR/CCPA/DPDP data deletion, Chrome Extension support, or marketplace rule updates.',
};
---

<BaseLayout
  title="Contact Support, Billing & Privacy Requests"
  description="Contact ListLift for subscription billing, refund requests, GDPR/CCPA/DPDP data deletion, Chrome Extension support, or marketplace rule updates."
  canonicalPath="/contact"
  jsonLd={webPageSchema}
>
  <div class="container" style="padding-top: var(--space-8); max-width: 680px;">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span aria-current="page">Contact</span>
    </nav>
    <h1>Contact Support &amp; Privacy Desk</h1>
    <p class="muted" style="margin-bottom: var(--space-6);">
      Email us directly at <a href="mailto:[support@yourdomain.com]">[support@yourdomain.com]</a> or send a message below for billing, refunds, Chrome Extension help, or GDPR/CCPA/DPDP data requests. We reply within 24 to 48 business hours.
    </p>
    <div class="card-elevated">
      <form onsubmit="event.preventDefault(); this.querySelector('[data-msg]').textContent = 'Thanks! Your request has been recorded. We will reply within 24 to 48 business hours.';" style="display:flex; flex-direction:column; gap:14px;">
        <div class="field">
          <label for="c-email">Email address</label>
          <input id="c-email" type="email" required class="input" placeholder="you@store.com" />
        </div>
        <div class="field">
          <label for="c-topic">Topic</label>
          <select id="c-topic" class="select">
            <option>Pro / Business Subscription &amp; Billing</option>
            <option>Refund Request (7-Day Window)</option>
            <option>Privacy / Delete My Data (GDPR, CCPA, DPDP)</option>
            <option>Chrome &amp; Edge Extension Support</option>
            <option>Report Marketplace Rule Update</option>
          </select>
        </div>
        <div class="field">
          <label for="c-notes">Message</label>
          <textarea id="c-notes" required class="textarea" rows={4} placeholder="Which marketplaces do you sell on?"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send message</button>
        <p data-msg class="badge badge-pass" style="margin:0; width:fit-content;" aria-live="polite"></p>
      </form>
    </div>
  </div>
</BaseLayout>
