# ListLift Server Environment Variables
# Copy this file to `.env` in the project root (for `npm run dev`)
# and/or `apps/web/.dev.vars` (for Cloudflare Wrangler).
# NEVER commit `.env` or `.dev.vars` — keys stay 100% server-side!

# PRIORITY #1: OmniRoute Self-Hosted / Local AI Gateway (https://github.com/cheaper-inference/OmniRoute)
# Pools all your free providers with dashboard routing & automatic failover.
# - Local dev: http://localhost:20128/v1 (run `npx omniroute` or `omniroute`)
# - 24/7 Production (works even when laptop is off): https://your-omniroute-vps-url/v1
# If OmniRoute is offline or unreachable, ListLift automatically falls back to the direct keys below!
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_VISION_MODEL=auto
OMNIROUTE_TEXT_MODEL=auto

# AUTOMATIC FALLBACK: Direct Free-Tier Vision + Text Chain (auto-switches on 429/quota):
# 1. Google Gemini Free Tier (Vision + Text: gemini-3.5-flash-lite -> gemini-3.8-flash -> gemini-3.6-flash)
GEMINI_API_KEY=

# 2. OpenRouter Free Auto-Router (Vision + Text: openrouter/free — $0 models only)
OPENROUTER_API_KEY=

# 3. Groq Free Tier (Ultra-fast Text Fallback: openai/gpt-oss-120b -> llama-3.1-8b-instant)
GROQ_API_KEY=

# Optional: Override model priority lists (comma-separated).
# Run `npm run check-models` to verify your keys and list every live model available on your account!
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash
# OPENROUTER_MODELS=openrouter/free
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.1-8b-instant

# Optional Cloudflare Turnstile (enforced in production)
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=

APP_ENV=development
